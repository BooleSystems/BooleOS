## booleos/tools/grub.cfg.in
## GRUB configuration TEMPLATE for BooleOS. The menu entry's version
## placeholder below is substituted with the version from
## kernel/version.h by the "GEN grub.cfg" rule in tools/Makefile — do
## not hardcode a version string here, and do not edit build/grub.cfg
## directly (it's generated and gets overwritten on the next build).

set timeout=3
set default=0

insmod all_video
insmod multiboot2

menuentry "BooleOS v@BOOLEOS_VERSION@" {
    multiboot2 /boot/booleos.elf
    module2    /boot/ramfs.img
    boot
}

menuentry "BooleOS (serial debug mode)" {
    multiboot2 /boot/booleos.elf debug
    module2    /boot/ramfs.img
    boot
}

menuentry "BooleOS (Safe Mode)" {
    multiboot2 /boot/booleos.elf safemode
    module2    /boot/ramfs.img
    boot
}

## PREV-BEGIN (this whole entry is dropped at build time when tools/prev/ has no snapshot)
menuentry "BooleOS v@PREV_VERSION@ (previous release)" {
    multiboot2 /boot/prev-booleos.elf
    module2    /boot/prev-ramfs.img
    boot
}
## PREV-END
